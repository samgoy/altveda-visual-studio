# AltVeda Visual Studio — Environment Variables

# WooCommerce
WOOCOMMERCE_URL=https://altveda.in
WOOCOMMERCE_KEY=your_woo_consumer_key
WOOCOMMERCE_SECRET=your_woo_consumer_secret

# Gemini (Pro subscription - altvedic@gmail.com)
GEMINI_API_KEY=your_gemini_api_key

# Cloudflare
CF_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_api_token

# YouTube (DJSamsi upload pattern)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# Compute
KAGGLE_GPU_VRAM=16
COLAB_GPU_VRAM=16

# Output
OUTPUT_DIR=./output
CACHE_DIR=./cache
LOG_LEVEL=info